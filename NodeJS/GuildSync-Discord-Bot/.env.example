DISCORD_TOKEN=YOUR_DISCORD_TOKEN
DISCORD_CLIENT_ID=YOUR_CLIENT ID
DISCORD_GUILD_ID=YOUR_GUILD_ID

GUILDSYNC_SOCKET_URL=http://localhost:3001
GUILDSYNC_BOT_KEY=KEY MUST BE SAME IN GUILDLSYNC ALSO

# Optional. If true, the bot checks the GuildSync backend on startup and runs a one-time
# historical message scan only if the backend says it has never completed before.
GUILDSYNC_HISTORICAL_SCAN_ON_STARTUP=true

# Optional. Maximum historical messages to check per text/announcement channel.
GUILDSYNC_HISTORICAL_SCAN_MESSAGE_LIMIT_PER_CHANNEL=1000

#Server/Thread where the Applications are posted to from GuildSyncAppliations
ESO_GUILD_APPLICATIONS=Server_ID:Thread_ID

# Optional raffle announcements. Leave channel blank to disable (does not disable /raffle).
# Bot needs View Channel, Send Messages, and Read Message History in DISCORD_GUILD_ID.
GUILDSYNC_RAFFLE_CHANNEL_ID=
GUILDSYNC_RAFFLE_INTERVAL_HOURS=48
# Positive hours before each bonus change/expiration or sales close; comma-separated
# values (for example 24,2,1) enable multiple reminders. Leave these defaults if unsure.
GUILDSYNC_RAFFLE_BONUS_REMINDER_HOURS=1
GUILDSYNC_RAFFLE_SALES_CLOSE_REMINDER_HOURS=2
# Thresholds are increments in PRIZE GOLD, not deposited gold.
GUILDSYNC_RAFFLE_BIWEEKLY_THRESHOLD=200000
GUILDSYNC_RAFFLE_MONTHLY_THRESHOLD=500000
# Relative to the bot directory. Keep this file across deployments/restarts.
GUILDSYNC_RAFFLE_STATE_FILE=data/raffle-announcements.json
